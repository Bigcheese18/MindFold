{
  "name": "mindfold",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "MindFold - 极简折角导图，纯本地离线个人学习工具",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "test": "node src/lib/model.test.mjs && node src/lib/outlineOps.test.mjs && node src/lib/store.test.mjs && node src/lib/model.refs.test.mjs && node src/lib/codeOps.test.mjs && node src/lib/codeOps.move.test.mjs && node src/lib/history.test.mjs && node src/lib/codeLineMap.test.mjs && node src/lib/shapes.test.mjs && node src/lib/zoomSteps.test.mjs && node src/lib/canvasHistory.test.mjs && node src/lib/treeOps.test.mjs && node src/lib/layout.converge.test.mjs && node src/lib/printLayout.test.mjs && node src/lib/formats.test.mjs && node src/lib/e2e.test.mjs",
    "test:logic": "node src/lib/model.test.mjs",
    "test:editor": "node src/lib/outlineOps.test.mjs",
    "test:store": "node src/lib/store.test.mjs",
    "test:ref": "node src/lib/model.refs.test.mjs",
    "test:code": "node src/lib/codeOps.test.mjs",
    "test:move": "node src/lib/codeOps.move.test.mjs",
    "test:history": "node src/lib/history.test.mjs",
    "test:linemap": "node src/lib/codeLineMap.test.mjs",
    "test:shape": "node src/lib/shapes.test.mjs",
    "test:zoomsteps": "node src/lib/zoomSteps.test.mjs",
    "test:canvas": "node src/lib/canvasHistory.test.mjs",
    "test:relate": "node src/lib/treeOps.test.mjs",
    "test:converge": "node src/lib/layout.converge.test.mjs",
    "test:print": "node src/lib/printLayout.test.mjs",
    "test:formats": "node src/lib/formats.test.mjs",
    "test:e2e": "node src/lib/e2e.test.mjs",
    "test:browser": "npm run build && node scripts/browser/smoke.mjs",
    "test:dualtrack": "node scripts/browser/dualtrack.mjs",
    "test:merge": "node scripts/browser/mergetest.mjs",
    "test:directlink": "node scripts/browser/directlink.mjs",
    "test:movebrowser": "node scripts/browser/movebrowser.mjs",
    "test:undo": "node scripts/browser/undotest.mjs",
    "test:link": "node scripts/browser/linktest.mjs",
    "test:canvasundo": "node scripts/browser/canvasundo.mjs",
    "test:relatebrowser": "node scripts/browser/relatebrowser.mjs",
    "test:zoompan": "node scripts/browser/zoompan.mjs",
    "test:mobile": "node scripts/browser/mobile.mjs",
    "test:mobileui": "node scripts/browser/mobileui.mjs",
    "test:perf": "node scripts/browser/perftest.mjs",
    "test:shapebrowser": "node scripts/browser/shape.mjs",
    "test:collapse": "node scripts/browser/collapse.mjs",
    "test:mobilefold": "node scripts/browser/mobilefold.mjs",
    "test:formats": "node scripts/browser/formats.mjs",
    "audit": "node scripts/audit.mjs",
    "shoot": "npm run build && node scripts/shoot.mjs",
    "icon": "node scripts/make-icon.mjs 1024 src-tauri/app-icon.png && tauri icon src-tauri/app-icon.png",
    "build:exe": "tauri build",
    "build:apk": "npm run build && cap sync android && cd android && gradlew.bat assembleRelease",
    "build:all": "npm run build:exe && npm run build:apk"
  },
  "dependencies": {
    "mermaid": "^11.17.2",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-zoom-pan-pinch": "^4.2.0"
  },
  "devDependencies": {
    "@capacitor/android": "^8.5.2",
    "@capacitor/cli": "^8.5.2",
    "@capacitor/core": "^8.5.2",
    "@tauri-apps/cli": "^2.11.5",
    "@vitejs/plugin-react": "^4.7.0",
    "autoprefixer": "^10.6.1",
    "postcss": "^8.5.28",
    "tailwindcss": "^3.4.19",
    "vite": "^5.4.21"
  }
}
